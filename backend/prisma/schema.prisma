generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  WARGA
  PENGURUS
}

enum StatusPembayaran {
  LUNAS
  BELUM_LUNAS
  MENUNGGU_KONFIRMASI
}

enum RT {
  RT_01
  RT_02
  RT_03
  RT_04
}

enum StatusPengumuman {
  active
  unactived
}

enum StatusKegiatan {
  active
  unactived
}

enum KategoriPengaduan {
  KEBERSIHAN
  KEAMANAN
  INFRASTRUKTUR
  LAINNYA
}

enum StatusPengaduan {
  MENUNGGU
  DIPROSES
  SELESAI
  DITOLAK
}

enum TipeKas {
  PEMASUKAN
  PENGELUARAN
}

enum TipeNotifikasi {
  TAGIHAN_BARU
  PEMBAYARAN_DIKONFIRMASI
  PEMBAYARAN_DITOLAK
  PEMBAYARAN_MASUK
  PENGADUAN_BARU
  PENGADUAN_DITANGGAPI
  PENGUMUMAN_BARU
  KEGIATAN_BARU
}

// ==========================================
// PERMISSIONS
// ==========================================

model RolePermission {
  id           Int      @id @default(autoincrement())
  role         Role     @map("role") // Menggunakan enum Role sebagai pengganti role_id
  permissionId Int      @map("permission_id") 
  createBy     String?  @map("create_by")
  createAt     DateTime @default(now()) @map("create_at")

  @@map("tb_Role_permission")
}

// ==========================================
// SESUAI PDM: TABEL MASTER DATA
// ==========================================

model User {
  id        Int      @id @default(autoincrement())
  namaUser  String   @map("nama_user")
  email     String   @unique
  password  String   
  noTelp    String?  @map("no_telp")
  role      Role     @default(WARGA) @map("role") // Kembali menggunakan enum Role
  createAt  DateTime @default(now()) @map("create_at")
  
  // Relasi
  rumah      Rumah[]  // 1 User bisa memiliki/menghuni banyak rumah
  pembayaran PembayaranIpl[]
  pengaduan  Pengaduan[]
  notifikasi Notifikasi[]

  @@map("tb_User")
}

model Rumah {
  id         Int      @id @default(autoincrement())
  rt         RT       @map("RT")
  blokRumah  String   @map("block_rumah")
  
  // Berdasarkan garis relasi dari tb_User ke tb_Rumah
  userId     Int?     @map("id_user")
  penghuni   User?    @relation(fields: [userId], references: [id])
  
  // Relasi
  tagihanIpl Ipl[]

  @@map("tb_Rumah")
}

// ==========================================
// SESUAI PDM: TRANSAKSI (TAGIHAN & PEMBAYARAN)
// ==========================================

// Ini merepresentasikan trx_IPL (Tagihan bulanan)
model Ipl {
  id               Int              @id @default(autoincrement())
  idRumah          Int              @map("Id_rumah")
  bulanPeriode     String           @map("bulan_periode")
  tahunPeriode     String           @map("tahun_periode")
  nominal          Int
  statusPembayaran StatusPembayaran @default(BELUM_LUNAS) @map("status_pembayaran")
  
  // Relasi
  rumah            Rumah            @relation(fields: [idRumah], references: [id])
  pembayaran       PembayaranIpl[]

  @@map("trx_IPL")
}

// Ini merepresentasikan trx_pembayaran_ipl (Riwayat saat user membayar tagihan)
model PembayaranIpl {
  idPembayaran    Int      @id @default(autoincrement()) @map("id_pembayaran")
  idUser          Int      @map("id_user")
  idIpl           Int      @map("Id_IPL")
  tanggalBayar    DateTime @default(now()) @map("tanggal_bayar")
  buktiTransaksi  String?  @map("bukti_transaksi")
  nominal         Int      @map("Nominal")
  catatan         String?  @map("catatan")

  // Relasi
  user            User     @relation(fields: [idUser], references: [id])
  ipl             Ipl      @relation(fields: [idIpl], references: [id])

  @@map("trx_pembayaran_ipl")
}

// ==========================================
// TABEL TAMBAHAN
// ==========================================

model Kegiatan {
  id           Int            @id @default(autoincrement())
  judul        String
  deskripsi    String   @db.Text
  gambarUrl    String
  tanggalAcara DateTime
  status       StatusKegiatan @default(active)
  createBy     String?
  createdAt    DateTime       @default(now())
  updateBy     String?
  updatedAt    DateTime?
  isDelete     Boolean        @default(false)
}

model Pengumuman {
  id                    Int              @id @default(autoincrement())
  judul                 String           @map("judul_pengumuman")
  filePengumuman        String?          @map("file_pengumuman")
  keteranganPengumuman  String?          @db.Text @map("keterangan_pengumuman")
  status                StatusPengumuman @default(active) @map("status")
  createBy              String?          @map("create_by")
  createDate            DateTime         @default(now()) @map("create_date")
  updateBy              String?          @map("update_by")
  updateDate            DateTime?        @map("update_date")
  isDelete              Boolean          @default(false) @map("is_delete")

  @@map("tb_Pengumuman")
}

model Pengaduan {
  id          Int               @id @default(autoincrement())
  idUser      Int
  pelapor     User              @relation(fields: [idUser], references: [id])
  judul       String
  kategori    KategoriPengaduan
  deskripsi   String            @db.Text
  fotoUrl     String?
  status      StatusPengaduan   @default(MENUNGGU)
  tanggapan   String?           @db.Text
  tanggapanBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?
  isDelete    Boolean           @default(false)
}

model Notifikasi {
  id        Int            @id @default(autoincrement())
  idUser    Int
  penerima  User           @relation(fields: [idUser], references: [id])
  tipe      TipeNotifikasi
  judul     String
  pesan     String         @db.Text
  link      String?
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())
}

// Transaksi kas manual (pemasukan non-IPL & seluruh pengeluaran).
// Pemasukan IPL dihitung otomatis dari tagihan LUNAS, tidak disimpan di sini.
model KasTransaksi {
  id         Int      @id @default(autoincrement())
  tipe       TipeKas
  kategori   String
  nominal    Int
  tanggal    DateTime @default(now())
  keterangan String?  @db.Text
  buktiFile  String?  @map("bukti_file")
  createBy   String?  @map("create_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("trx_kas")
}